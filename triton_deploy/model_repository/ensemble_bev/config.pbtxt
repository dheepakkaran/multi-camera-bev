# ============================================================
# ensemble_bev / config.pbtxt
# ============================================================
# PIPELINE definition. Client ORE request anuppum ->
# Triton ULLA backbone -> decoder nu odi, final answer thirupi kudukkum.
#
# Yaen ensemble? Ithu illaina client 2 request anuppanum, naduvula
# features tensor-ai GPU-la irundhu network vazhiya izhukkanum
# (6x64x14x25 x4 bytes = 537 KB ovvoru frame-kum). Ensemble-la antha
# data GPU-lave irukkum - network round-trip SAVE aagum.
# ============================================================

name: "ensemble_bev"
platform: "ensemble"
max_batch_size: 0

input [
  { name: "images"    data_type: TYPE_FP32  dims: [ 6, 3, 224, 400 ] },
  { name: "geometry"  data_type: TYPE_FP32  dims: [ 6, 64, 14, 25, 3 ] }
]

output [
  { name: "heatmap"  data_type: TYPE_FP32  dims: [ 1, 10, 200, 200 ] },
  { name: "offset"   data_type: TYPE_FP32  dims: [ 1,  2, 200, 200 ] },
  { name: "height"   data_type: TYPE_FP32  dims: [ 1,  1, 200, 200 ] },
  { name: "size"     data_type: TYPE_FP32  dims: [ 1,  3, 200, 200 ] },
  { name: "rot"      data_type: TYPE_FP32  dims: [ 1,  2, 200, 200 ] },
  { name: "vel"      data_type: TYPE_FP32  dims: [ 1,  2, 200, 200 ] }
]

ensemble_scheduling {
  step [
    {
      model_name: "camera_backbone"
      model_version: -1                     # -1 = latest version
      input_map  { key: "images"    value: "images" }
      # "camera_features" = ensemble ulla mattum irukkura temp name
      output_map { key: "features"  value: "camera_features" }
    },
    {
      model_name: "bev_decoder"
      model_version: -1
      input_map  { key: "features"  value: "camera_features" }   # <- connect
      input_map  { key: "geometry"  value: "geometry" }
      output_map { key: "heatmap"   value: "heatmap" }
      output_map { key: "offset"    value: "offset" }
      output_map { key: "height"    value: "height" }
      output_map { key: "size"      value: "size" }
      output_map { key: "rot"       value: "rot" }
      output_map { key: "vel"       value: "vel" }
    }
  ]
}
