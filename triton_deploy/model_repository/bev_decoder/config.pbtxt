# ============================================================
# bev_decoder / config.pbtxt
# ============================================================
# features + geometry -> BEV detection heads (LSS + encoder + head).
#
# geometry yaen input? Camera calibration car-la FIX. So frustum
# points ORE thadava compute panni, client cache pannikkum.
# Inference-la thirumba thirumba compute panna vendaam.
# ============================================================

name: "bev_decoder"
platform: "tensorrt_plan"
max_batch_size: 0

input [
  {
    name: "features"
    data_type: TYPE_FP32
    dims: [ 6, 64, 14, 25 ]         # camera_backbone output NERADIYA
  },
  {
    name: "geometry"
    data_type: TYPE_FP32
    dims: [ 6, 64, 14, 25, 3 ]      # ego-frame 3D points (metres)
  }
]

output [
  { name: "heatmap"  data_type: TYPE_FP32  dims: [ 1, 10, 200, 200 ] },
  { name: "offset"   data_type: TYPE_FP32  dims: [ 1,  2, 200, 200 ] },
  { name: "height"   data_type: TYPE_FP32  dims: [ 1,  1, 200, 200 ] },
  { name: "size"     data_type: TYPE_FP32  dims: [ 1,  3, 200, 200 ] },
  { name: "rot"      data_type: TYPE_FP32  dims: [ 1,  2, 200, 200 ] },
  { name: "vel"      data_type: TYPE_FP32  dims: [ 1,  2, 200, 200 ] }
]

instance_group [
  {
    count: 1                        # decoder oru thadava mattum odum
    kind: KIND_GPU
  }
]
